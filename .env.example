# aiprint configuration
# Server
PORT=3600

# ---- Providers (get a key from each you want to enable) ----
# Meshy:  https://www.meshy.ai  -> API keys.  Image-to-3D ~30 credits, returns STL + 3MF natively.
MESHY_API_KEY=

# Tripo:  https://developers.tripo3d.ai -> API keys.  1 credit = $0.01, image-to-model ~30 credits, returns GLB.
TRIPO_API_KEY=

# Which provider a generic key/3d.key belongs to (tripo | meshy). Key files under key/ are auto-loaded at startup.
KEY_PROVIDER=tripo
