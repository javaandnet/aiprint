# aiprint configuration
# Server
PORT=3600

# ---- Providers (get a key from each you want to enable) ----
# Meshy:  https://www.meshy.ai  -> API keys.  Image-to-3D ~30 credits, returns STL + 3MF natively.
MESHY_API_KEY=

# Tripo:  https://developers.tripo3d.ai -> API keys.  1 credit = $0.01, image-to-model ~30 credits, returns GLB.
TRIPO_API_KEY=

# Which provider a generic key/3d.key belongs to (tripo | meshy). Key files under key/ are auto-loaded at startup.
KEY_PROVIDER=tripo

# ---- Slicing (OrcaSlicer headless, Bambu Lab P2S) ----
# Optional: absolute path to the OrcaSlicer binary. Auto-detected from
# /Applications/OrcaSlicer.app when unset.
# ORCASLICER_BIN=/Applications/OrcaSlicer.app/Contents/MacOS/OrcaSlicer
# Optional: override the bundled Bambu profiles dir (machine/process/filament).
# ORCA_PROFILES_DIR=

# ---- Bambu LAN push (optional, experimental) ----
# Optional: path to a CA cert to strictly verify the printer's TLS cert.
# When unset, LAN TLS falls back to trust-on-first-use (trusted LAN only).
# BAMBU_CA_FILE=
